{
  "name": "claimbot-frontend",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:rules": "node scripts/rules-self-test.mjs",
    "test": "node scripts/rules-self-test.mjs && node scripts/intelligence-self-test.mjs && node scripts/project-self-check.mjs",
    "test:project": "node scripts/project-self-check.mjs",
    "verify": "npm test && npm run typecheck && npm run build && npm run lint",
    "test:intelligence": "node scripts/intelligence-self-test.mjs"
  },
  "dependencies": {
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^24.10.2",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "4.1.12",
    "tw-animate-css": "1.3.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "6.4.3"
  }
}
