# Frontend: leave empty for the self-contained local/demo mode.
# Set this only when running the optional FastAPI persistence/auth backend.
VITE_API_BASE_URL=

# Optional Vercel server-side AI helpers. The deterministic ClaimBot core,
# policy intelligence and public-source retrieval work without these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
