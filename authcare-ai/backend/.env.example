# Local FastAPI defaults to SQLite if DATABASE_URL is omitted.
DATABASE_URL=sqlite:///./claimbot.db

# Generate long random values; do not reuse these example placeholders.
CLAIMBOT_JWT_SECRET=
CLAIMBOT_BOOTSTRAP_TOKEN=
CLAIMBOT_CORS_ORIGINS=http://localhost:5173
CLAIMBOT_TOKEN_MINUTES=480

# Keep PHI disabled until a privacy/security review is complete.
CLAIMBOT_ALLOW_PHI=false
# A Fernet key is only needed for the guarded PHI-capable fields.
CLAIMBOT_DATA_KEY=

# Optional Qdrant. Leave blank to use database/local cosine retrieval.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=claimbot_public_knowledge
